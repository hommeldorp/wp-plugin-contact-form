{
	"name": "contact-form",
	"version": "0.1.0",
	"description": "A block that opens a contact form panel when clicked.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --webpack-copy-php --blocks-manifest",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --webpack-copy-php --blocks-manifest",
		"make-pot": "wp i18n make-pot . languages/contact-form.pot --exclude=node_modules,vendor",
		"make-json": "wp i18n make-json languages --no-purge --extensions=js,.min.js,jsx"
	},
	"dependencies": {
		"@wordpress/block-editor": "latest",
		"@wordpress/blocks": "latest",
		"@wordpress/i18n": "latest",
		"cap-widget": "^0.1.56"
	},
	"devDependencies": {
		"@wordpress/components": "^37.0.0",
		"@wordpress/icons": "^15.2.0",
		"@wordpress/scripts": "^33.0.0"
	}
}
